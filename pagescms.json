{
	"config": {
		"repositories": [
			{
				"name": "auto-service",
				"url": "https://github.com/your-username/auto-service"
			}
		],
		"collections": [
			{
				"name": "services",
				"label": "Послуги",
				"folder": "src/content/services",
				"fields": [
					{ "name": "title", "label": "Назва послуги", "type": "string" },
					{ "name": "description", "label": "Опис", "type": "rich-text" },
					{ "name": "price", "label": "Ціна", "type": "string" },
					{ "name": "image", "label": "Зображення", "type": "image" }
				]
			},
			{
				"name": "reviews",
				"label": "Відгуки",
				"folder": "src/content/reviews",
				"fields": [
					{ "name": "client", "label": "Клієнт", "type": "string" },
					{ "name": "text", "label": "Текст відгуку", "type": "rich-text" },
					{ "name": "rating", "label": "Рейтинг", "type": "number" }
				]
			}
		]
	}
}
