---
import './SocialLinks.scss';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';

interface Props {
	className?: string;
	socialOnly?: boolean;
}

const { className = '', socialOnly = false } = Astro.props;
const socialLinks = Object.fromEntries(site.socialLinks.map((link) => [link.icon, link]));
const phoneLink = {
	href: site.phone.href,
	label: `Зателефонувати: ${site.phone.display}`,
	title: 'Телефон',
	icon: 'phone',
	external: false,
};
const links = [
	...(socialOnly ? [] : [phoneLink]),
	socialLinks.telegram,
	socialLinks.viber,
	socialLinks.instagram,
];
---

<nav
	class={`social-links ${className}`.trim()}
	aria-label={socialOnly ? 'Соціальні мережі' : 'Телефон і соціальні мережі'}
>
	{
		links.map((link) => (
			<a
				class='social-links__item'
				href={link.href}
				aria-label={link.label}
				title={link.title}
				target={link.external ? '_blank' : undefined}
				rel={link.external ? 'noopener noreferrer' : undefined}
			>
				<Icon name={link.icon} width='22' height='22' />
			</a>
		))
	}
</nav>
