---
import './NavLinks.scss';
import { site } from '../../data/site';

interface Props {
	className?: string;
}

const { className = '' } = Astro.props;
const links = site.navigation;
---

<ul class={className} role='list'>
	{links.map((link) => (
		<li><a class='nav-links__item' data-nav-link href={link.href}>{link.label}</a></li>
	))}
</ul>
