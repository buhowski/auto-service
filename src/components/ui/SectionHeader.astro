---
import './SectionHeader.scss';
interface Props {
	id?: string;
  eyebrow: string;
  headline: string;
  centered?: boolean;
  class?: string;
}

const { id, eyebrow, headline, centered = false, class: className = '' } = Astro.props;

const classes = [
  'section-header',
  centered && 'section-header--center',
  className,
].filter(Boolean).join(' ');
---
<div class={classes}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 id={id} class="h2">{headline}</h2>
</div>
