---
import './Button.scss';

interface Props {
	variant?: 'dark' | 'outline' | 'primary' | 'secondary';
	block?: boolean;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
	'aria-label'?: string;
	target?: string;
	rel?: string;
}

const {
	variant = 'primary',
	block = false,
	href,
	type = 'button',
	class: className = '',
	'aria-label': ariaLabel,
	target,
	rel,
	...attrs
} = Astro.props;

const isExternal = href?.startsWith('http://') || href?.startsWith('https://');
const classes = ['button', `button--${variant}`, block && 'button--block', className]
	.filter(Boolean)
	.join(' ');
---

{
	href ? (
		<a
			class={classes}
			href={href}
			aria-label={ariaLabel}
			target={isExternal ? '_blank' : target}
			rel={isExternal ? 'noopener noreferrer' : rel}
			{...attrs}
		>
			<slot />
		</a>
	) : (
		<button class={classes} type={type} aria-label={ariaLabel} {...attrs}>
			<slot />
		</button>
	)
}
