---
import './Button.scss';

interface Props {
	variant?: string;
	block?: boolean;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
	'aria-label'?: string;
}

const {
	variant = 'accent',
	block = false,
	href,
	type = 'button',
	class: className = '',
	'aria-label': ariaLabel,
	...attrs
} = Astro.props;

const classes = ['btn', `btn--${variant}`, block && 'btn--block', className]
	.filter(Boolean)
	.join(' ');
---

{
	href ? (
		<a class={classes} href={href} aria-label={ariaLabel} {...attrs}>
			<slot />
		</a>
	) : (
		<button class={classes} type={type} aria-label={ariaLabel} {...attrs}>
			<slot />
		</button>
	)
}
