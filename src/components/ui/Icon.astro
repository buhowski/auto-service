---
import BrandMark from '../../assets/icons/brandMark.svg';
import Certified from '../../assets/icons/certified.svg';
import CircleArrowDown from '../../assets/icons/circle-arrow-down.svg';
import ChevronLeft from '../../assets/icons/chevronLeft.svg';
import ChevronRight from '../../assets/icons/chevronRight.svg';
import Clock from '../../assets/icons/clock.svg';
import Close from '../../assets/icons/close.svg';
import GoogleMaps from '../../assets/icons/google-maps.svg';
import Instagram from '../../assets/icons/instagram.svg';
import Location from '../../assets/icons/location.svg';
import Phone from '../../assets/icons/phone.svg';
import Quote from '../../assets/icons/quote.svg';
import Speed from '../../assets/icons/speed.svg';
import Star from '../../assets/icons/star.svg';
import StarOutline from '../../assets/icons/star-outline.svg';
import Step1 from '../../assets/icons/step1.svg';
import Step2 from '../../assets/icons/step2.svg';
import Step3 from '../../assets/icons/step3.svg';
import Telegram from '../../assets/icons/telegram.svg';
import Viber from '../../assets/icons/viber.svg';
import Warranty from '../../assets/icons/warranty.svg';

interface Props {
	name: string;
	class?: string;
	width?: number | string;
	height?: number | string;
	'aria-hidden'?: boolean;
	fill?: string;
}

const {
	name,
	class: className = '',
	width = 24,
	height = 24,
	'aria-hidden': ariaHidden = true,
	fill,
} = Astro.props;

const icons = {
	brandMark: BrandMark,
	certified: Certified,
	circleArrowDown: CircleArrowDown,
	chevronLeft: ChevronLeft,
	chevronRight: ChevronRight,
	clock: Clock,
	close: Close,
	'google-maps': GoogleMaps,
	instagram: Instagram,
	location: Location,
	phone: Phone,
	quote: Quote,
	speed: Speed,
	star: Star,
	starOutline: StarOutline,
	step1: Step1,
	step2: Step2,
	step3: Step3,
	telegram: Telegram,
	viber: Viber,
	warranty: Warranty,
} as const;

const IconComponent = icons[name as keyof typeof icons] ?? BrandMark;
---

<IconComponent
	class={className}
	style='fill: currentColor;'
	width={width}
	height={height}
	aria-hidden={ariaHidden}
	fill={fill}
/>
