---
import './Icon.scss';

const iconFiles = {
	brandMark: 'brandMark.svg',
	certified: 'certified.svg',
	circleArrowDown: 'circle-arrow-down.svg',
	chevronLeft: 'chevronLeft.svg',
	chevronRight: 'chevronRight.svg',
	clock: 'clock.svg',
	close: 'close.svg',
	'google-maps': 'google-maps.svg',
	instagram: 'instagram.svg',
	location: 'location.svg',
	phone: 'phone.svg',
	quote: 'quote.svg',
	speed: 'speed.svg',
	star: 'star.svg',
	starOutline: 'star-outline.svg',
	step1: 'step1.svg',
	step2: 'step2.svg',
	step3: 'step3.svg',
	telegram: 'telegram.svg',
	viber: 'viber.svg',
	warranty: 'warranty.svg',
} as const;

interface Props {
	name: keyof typeof iconFiles;
	class?: string;
	width?: 16 | 20 | 22 | 24 | '16' | '20' | '22' | '24';
	height?: 16 | 20 | 22 | 24 | '16' | '20' | '22' | '24';
	'aria-hidden'?: boolean;
}

const {
	name,
	class: className = '',
	width = 24,
	height = 24,
	'aria-hidden': ariaHidden = true,
} = Astro.props;

---

<span
	class:list={['icon', className]}
	data-icon={name in iconFiles ? name : 'brandMark'}
	data-width={String(width)}
	data-height={String(height)}
	aria-hidden={ariaHidden}
></span>
