---
interface Props {
	name: string;
	class?: string;
	width?: number | string;
	height?: number | string;
	'aria-hidden'?: boolean;
}

const {
	name,
	class: className = '',
	width = 24,
	height = 24,
	'aria-hidden': ariaHidden = true,
} = Astro.props;

const iconFiles: Record<string, string> = {
	brandMark: 'brandMark.svg',
	certified: 'certified.svg',
	circleArrowDown: 'circle-arrow-down.svg',
	chevronLeft: 'chevronLeft.svg',
	chevronRight: 'chevronRight.svg',
	clock: 'clock.svg',
	close: 'close.svg',
	'google-maps': 'google-maps.svg',
	instagram: 'instagram.svg',
	location: 'location.svg',
	phone: 'phone.svg',
	quote: 'quote.svg',
	speed: 'speed.svg',
	star: 'star.svg',
	starOutline: 'star-outline.svg',
	step1: 'step1.svg',
	step2: 'step2.svg',
	step3: 'step3.svg',
	telegram: 'telegram.svg',
	viber: 'viber.svg',
	warranty: 'warranty.svg',
};

const iconPath = `/uploads/icons/${iconFiles[name] ?? iconFiles.brandMark}`;
const toCssSize = (size: number | string) =>
	typeof size === 'number' || /^\d+(\.\d+)?$/.test(size) ? `${size}px` : size;
const iconWidth = toCssSize(width);
const iconHeight = toCssSize(height);
---

<span
	class:list={['icon-mask', className]}
	style={`--icon-width: ${iconWidth}; --icon-height: ${iconHeight}; --icon-source: url('${iconPath}');`}
	aria-hidden={ariaHidden}
></span>
