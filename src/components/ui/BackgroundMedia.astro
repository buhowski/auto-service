---
import './BackgroundMedia.scss';

interface Props {
	media: {
		image?: string;
		video?: string;
		mobileVideo?: string;
		alt?: string;
	};
	fetchPriority?: 'high' | 'low' | 'auto';
}

const { media, fetchPriority = 'auto' } = Astro.props;
const desktopVideo = media.video?.trim();
const mobileVideo = media.mobileVideo?.trim() || desktopVideo;
const desktopSource = desktopVideo || mobileVideo;
const imageSource = media.image?.trim();
const getVideoType = (source?: string) => {
	const path = source?.split(/[?#]/, 1)[0].toLowerCase();
	return path?.endsWith('.webm') ? 'video/webm' : path?.endsWith('.mp4') ? 'video/mp4' : undefined;
};
---

{
	desktopSource ? (
		<video
			class='background-media'
			data-poster={imageSource || undefined}
			autoplay
			muted
			loop
			playsinline
			disablepictureinpicture
			disableRemotePlayback
			preload='none'
			aria-hidden='true'
		>
			<source data-src={mobileVideo} type={getVideoType(mobileVideo)} media='(max-width: 767px)' />
			<source
				data-src={desktopSource}
				type={getVideoType(desktopSource)}
				media='(min-width: 768px)'
			/>
		</video>
	) : imageSource ? (
		<img
			class='background-media'
			data-src={imageSource}
			alt={media.alt ?? ''}
			width='1920'
			height='1080'
			fetchpriority={fetchPriority}
		/>
	) : null
}

<script src='../../scripts/background-media.ts'></script>
