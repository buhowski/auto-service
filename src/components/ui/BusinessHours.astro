---
import './BusinessHours.scss';
import { site } from '../../data/site';
import { openingSchedule } from '../../data/openingHours';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
const weekdays = openingSchedule.find((group) => group.days.includes(1));
const saturday = openingSchedule.find((group) => group.days.includes(6));
const formatHours = (group?: (typeof openingSchedule)[number]) =>
	group?.open && group.close ? `${group.open}–${group.close}` : 'Зачинено';
---

<div class:list={['business-hours', className]}>
	<span class='business-hours__city'>{site.city}</span>
	<svg
		xmlns='http://www.w3.org/2000/svg'
		width='1em'
		height='1em'
		viewBox='0 0 24 24'
		fill='none'
		stroke='currentColor'
		stroke-width='2'
		stroke-linecap='round'
		stroke-linejoin='round'
		class='business-hours__clock lucide lucide-clock3'
		aria-hidden='true'
	>
		<circle cx='12' cy='12' r='10'></circle>
		<polyline points='12 6 12 12 16.5 12'></polyline>
	</svg>
	<span class='business-hours__schedule'>
		<span>Пн-Пт: {formatHours(weekdays)}</span>
		<span class='business-hours__schedule-dot' aria-hidden='true'> · </span>
		<span>Сб: {formatHours(saturday)}</span>
	</span>
</div>
