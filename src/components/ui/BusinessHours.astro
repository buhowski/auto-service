---
import './BusinessHours.scss';
import Icon from './Icon.astro';
import { site } from '../../data/site';
import { openingSchedule } from '../../data/openingHours';

interface Props {
	class?: string;
	id: string;
}

const { class: className = '', id } = Astro.props;
const dayLabels = ['Нд', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
---

<div class={`business-hours ${className}`.trim()} data-business-hours>
	<button
		class='business-hours__trigger'
		type='button'
		aria-expanded='false'
		aria-controls={`${id}-panel`}
	>
		<span class='business-hours__city'>{site.city}</span>
		<span class='business-hours__status' data-business-status>
			<span class='business-hours__dot' aria-hidden='true'></span>
			<span data-business-status-text>Перевіряємо статус</span>
		</span>
		<Icon name='chevronRight' class='business-hours__chevron' width='14' height='14' />
	</button>
	<div
		class='business-hours__panel'
		id={`${id}-panel`}
		role='group'
		aria-label='Графік роботи'
		hidden
	>
		{
			openingSchedule.map((group) => (
				<div
					class='business-hours__row'
					data-schedule-days={group.days.join(',')}
					data-open={group.open}
					data-close={group.close}
				>
					<span>{group.label}</span>
					<span class={!group.open ? 'business-hours__closed' : undefined}>
						{group.open && group.close ? `${group.open}–${group.close}` : 'Зачинено'}
					</span>
				</div>
			))
		}
	</div>
</div>

<script src="../../scripts/business-hours.ts"></script>
