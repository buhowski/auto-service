---
import './Footer.scss';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

const footerData = (await getCollection('footer', ({ id }) => id === 'main'))[0]?.data;
const brandParts = footerData.brand.name.split(footerData.brand.highlightedPart);
---

<footer class="footer" role="contentinfo">
  <div class="hazard-thin" role="presentation"></div>
  <Container size="lg">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${footerData.brand.name} — home`}>
          <span class="brand-mark" aria-hidden="true">
            <Icon name="brandMark" width="24" height="24" />
          </span>
          {brandParts[0]}<b>{footerData.brand.highlightedPart}</b>{brandParts[1]}
        </a>
        <p class="footer-about">{footerData.about}</p>
        <div class="footer-social" role="list" aria-label="Social links">
          {footerData.social.map(social => (
            <a href={social.href} aria-label={social.ariaLabel} role="listitem">
              <Icon name={social.icon} width="20" height="20" />
            </a>
          ))}
        </div>
      </div>
      
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <h4>Послуги</h4>
          <ul>
            {footerData.links.services.map(link => (
              <li><a href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Компанія</h4>
          <ul>
            {footerData.links.company.map(link => (
              <li><a href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Завітайте до нас</h4>
          <ul class="footer-contact">
            {footerData.links.visit.map(item => (
              <li>
                <Icon name={item.icon} width="20" height="20" />
                {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
    
    <div class="footer-bottom">
      <p class="copyright">{footerData.copyright}</p>
      <a href="#main">{footerData.backToTop}</a>
    </div>
  </Container>
</footer>

