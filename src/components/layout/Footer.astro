---
import './Footer.scss';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const footerAbout =
	'Сімейне СТО у Львові: чесні кошториси, сертифіковані майстри та гарантія 24 місяці на кожну роботу.';
const address = 'вул. Сирецька, 42, Львів, 79000';
const mapsUrl = 'https://maps.google.com/?q=вул.+Сирецька,+42,+Львів';
---

<footer class='footer' role='contentinfo'>
	<div class='hazard-thin' role='presentation'></div>
	<Container size='lg'>
		<div class='footer-main'>
			<div class='footer-brand'>
				<a class='brand' href='/' aria-label='СТО Поршень — на початок сторінки'>
					<span class='brand-mark' aria-hidden='true'>
						<Icon name='brandMark' width='24' height='24' />
					</span>
					СТО <b>Поршень</b>
				</a>
				<p class='footer-about'>{footerAbout}</p>
				<SocialLinks className='footer-social' />
			</div>

			<address class='footer-contact' aria-label='Контактна інформація'>
				<a class='footer-contact__item footer-contact__phone' href='tel:+380322345678'>
					<Icon name='phone' width='20' height='20' />
					<span>(032) 234-56-78</span>
				</a>
				<a class='footer-contact__item' href={mapsUrl} target='_blank' rel='noreferrer'>
					<Icon name='location' width='20' height='20' />
					<span>{address}</span>
				</a>
				<p class='footer-contact__item footer-hours'>
					<Icon name='clock' width='20' height='20' />
					<span>Пн-Пт 07:30-18:00 · Сб 08:00-15:00 · Нд зачинено</span>
				</p>
			</address>
		</div>

		<div class='footer-bottom'>
			<p class='copyright'>© {year} СТО Поршень. Усі права захищено.</p>
		</div>
	</Container>
</footer>
