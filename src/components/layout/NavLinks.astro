---
import { site } from '../../data/site';

interface Props {
	className?: string;
}

const { className = '' } = Astro.props;
const links = [
	{ href: site.links.services, label: 'Послуги' },
	{ href: site.links.whyUs, label: 'Чому ми' },
	{ href: site.links.testimonials, label: 'Відгуки' },
	{ href: site.links.contacts, label: 'Контакти' },
];
---

<ul class={className} role='list'>
	{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
</ul>
