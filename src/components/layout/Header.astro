---
import './Header.scss';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

const footerData = (await getCollection('footer', ({ id }) => id === 'main'))[0]?.data;
const brandParts = footerData.brand.name.split(footerData.brand.highlightedPart);
---

<header class="header" role="banner">
  <nav class="nav" aria-label="Primary navigation">
      <Container size="lg">
      <a class="brand" href="/" aria-label={`${footerData.brand.name} — home`}>
        <span class="brand-mark" aria-hidden="true">
          <Icon name="brandMark" width="24" height="24" />
        </span>
        {brandParts[0]}<b>{footerData.brand.highlightedPart}</b>{brandParts[1]}
      </a>
      
      <ul class="nav-links nav-desktop" role="list">
        <li><a href="/">Головна</a></li>
        <li><a href="#services">Послуги</a></li>
        <li><a href="#visit">Графік</a></li>
        <li><a href="#why-choose">Чому ми</a></li>
      </ul>
      
      <div class="nav-cta nav-desktop">
        <a href="tel:+380322345678" class="btn btn--ghost btn--sm">
          <Icon name="phone" width="16" height="16" />
          (032) 234-56-78
        </a>
        <a href="#quote" class="btn btn--accent btn--sm">Записатися</a>
      </div>
      
      <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
      </Container>
  </nav>
  
  <div class="overlay" aria-hidden="true"></div>
  <nav class="mobile" id="mobileMenu" aria-label="Mobile navigation">
    <button class="mobile-close" aria-label="Close menu">
      <Icon name="close" width="24" height="24" />
    </button>
    <a href="/">Головна</a>
    <a href="#services">Послуги</a>
    <a href="#visit">Графік</a>
    <a href="#why-choose">Чому ми</a>
    <a href="#quote" class="btn btn--accent btn--block">Записатися на обслуговування</a>
    <a href="tel:+380322345678" class="btn btn--ghost btn--block">
      <Icon name="phone" width="18" height="18" />
      (032) 234-56-78
    </a>
  </nav>
</header>



<script>
  // Mobile navigation
  document.addEventListener('DOMContentLoaded', () => {
    const burger = document.querySelector('.burger');
    const menu = document.querySelector('.mobile');
    const overlay = document.querySelector('.overlay');
    const closeBtn = document.querySelector('.mobile-close');
    
    if (!burger || !menu) return;
    
    function open() {
      menu.classList.add('open');
      overlay?.classList.add('open');
      burger.classList.add('open');
      burger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('nav-lock');
    }
    
    function close() {
      menu.classList.remove('open');
      overlay?.classList.remove('open');
      burger.classList.remove('open');
      burger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-lock');
    }
    
    function toggle() {
      menu.classList.contains('open') ? close() : open();
    }
    
    burger.addEventListener('click', toggle);
    overlay?.addEventListener('click', close);
    closeBtn?.addEventListener('click', close);
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) close();
    });
    const nav = document.querySelector('.nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
