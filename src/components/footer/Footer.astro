---
import './Footer.scss';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import BusinessHours from '../ui/BusinessHours.astro';
import Brand from '../ui/Brand.astro';
import SocialLinks from '../header/SocialLinks.astro';
import { footerAbout, site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class='footer' role='contentinfo'>
	<div class='footer__hazard' role='presentation'></div>
	<Container>
		<div class='footer__main'>
			<div>
				<Brand class='footer__brand-link' />
				<p class='footer__about'>{footerAbout}</p>
			</div>

			<address class='footer__contact' aria-label='Контактна інформація'>
				<a
					class='footer__contact-item'
					href={site.address.mapsUrl}
					target='_blank'
					rel='noopener noreferrer'
				>
					<Icon name='location' width='20' height='20' />
					<span>{site.address.full}</span>
				</a>

			<SocialLinks className='footer__social' />
			</address>
		</div>

		<div class='footer__bottom'>
			<BusinessHours class='footer__business-hours' />

			<p class='footer__copyright'>© {year} {site.name}. Усі права захищено.</p>
		</div>
	</Container>
</footer>
