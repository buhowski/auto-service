---
import './Brands.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import content from '../../content/homepage.json';
const brandsData = content.brands;
---

<section class='brands' aria-labelledby='brands-heading'>
	<Container>
		<SectionHeader
			id='brands-heading'
			eyebrow={brandsData.eyebrow}
			headline={brandsData.headline}
			description={`${brandsData.eyebrow}. Не знайшли свою марку? Зателефонуйте — уточнимо можливість обслуговування.`}
			centered
			class='brands__intro reveal'
		/>
		<div
			class='brands__carousel reveal'
			data-brands-carousel
			role='region'
			aria-label='Марки автомобілів, які ми обслуговуємо'
		>
			<div class='brands__track' data-brands-track>
				{
					[false, true].map((isDuplicate) => (
						<ul class='brands__grid' data-brands-grid aria-hidden={isDuplicate ? 'true' : undefined}>
							{brandsData.items.map(({ name, logo }) => (
								<li class='brands__item' data-brand-item>
									<img class='brands__logo' src={logo} alt='' aria-hidden='true' draggable={false} />
									<span data-brand-label>{name}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</Container>
</section>

<script src='../../scripts/brands.ts'></script>
