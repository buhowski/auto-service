---
import './Brands.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import content from '../../content/homepage.json';
const brandsData = content.brands;
---

<section class='brands-section' aria-labelledby='brands-heading'>
	<Container>
		<SectionHeader
			id='brands-heading'
			eyebrow={brandsData.eyebrow}
			headline={brandsData.headline}
			description={`${brandsData.eyebrow}. Не знайшли свою марку? Зателефонуйте — уточнимо можливість обслуговування.`}
			centered
			class='brands-intro reveal'
		/>
		<div
			class='brands-carousel reveal'
			role='region'
			aria-label='Марки автомобілів, які ми обслуговуємо'
		>
			<div class='brands-track'>
				{
					[false, true].map((isDuplicate) => (
						<ul class='brands-grid' aria-hidden={isDuplicate ? 'true' : undefined}>
							{brandsData.items.map(({ name, logo }) => (
								<li class='brand-item surface-card'>
								<img class='brand-logo' src={logo} alt='' aria-hidden='true' draggable={false} />
									<span>{name}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</Container>
</section>

<script src="../../scripts/brands.ts"></script>
