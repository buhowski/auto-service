---
import './Brands.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import AudiLogo from '../../assets/brands/audi.svg';
import BMWLogo from '../../assets/brands/bmw.svg';
import BYDLogo from '../../assets/brands/byd.svg';
import FordLogo from '../../assets/brands/ford.svg';
import HondaLogo from '../../assets/brands/honda.svg';
import HyundaiLogo from '../../assets/brands/hyundai.svg';
import KiaLogo from '../../assets/brands/kia.svg';
import MazdaLogo from '../../assets/brands/mazda.svg';
import MercedesBenzLogo from '../../assets/brands/mercedes-benz.svg';
import NissanLogo from '../../assets/brands/nissan.svg';
import RenaultLogo from '../../assets/brands/renault.svg';
import SkodaLogo from '../../assets/brands/skoda.svg';
import SuzukiLogo from '../../assets/brands/suzuki.svg';
import TeslaLogo from '../../assets/brands/tesla.svg';
import ToyotaLogo from '../../assets/brands/toyota.svg';
import VolkswagenLogo from '../../assets/brands/volkswagen.svg';
const brandsData = {
	eyebrow: 'Обслуговуємо популярні марки авто',
	items: [
		{ name: 'Toyota', logo: ToyotaLogo },
		{ name: 'Volkswagen', logo: VolkswagenLogo },
		{ name: 'Renault', logo: RenaultLogo },
		{ name: 'Škoda', logo: SkodaLogo },
		{ name: 'BMW', logo: BMWLogo },
		{ name: 'Hyundai', logo: HyundaiLogo },
		{ name: 'Audi', logo: AudiLogo },
		{ name: 'Nissan', logo: NissanLogo },
		{ name: 'Ford', logo: FordLogo },
		{ name: 'BYD', logo: BYDLogo },
		{ name: 'Mazda', logo: MazdaLogo },
		{ name: 'Honda', logo: HondaLogo },
		{ name: 'Kia', logo: KiaLogo },
		{ name: 'Mercedes-Benz', logo: MercedesBenzLogo },
		{ name: 'Tesla', logo: TeslaLogo },
		{ name: 'Suzuki', logo: SuzukiLogo },
	],
};
---

<section class='brands-section' aria-labelledby='brands-heading'>
	<Container size='lg'>
		<SectionHeader
			id='brands-heading'
			eyebrow='Працюємо з різними марками'
			headline='Сервіс для вашого авто'
			description={`${brandsData.eyebrow}. Не знайшли свою марку? Зателефонуйте — уточнимо можливість обслуговування.`}
			centered
			class='brands-intro reveal'
		/>
		<div
			class='brands-carousel reveal'
			role='region'
			aria-label='Марки автомобілів, які ми обслуговуємо'
		>
			<div class='brands-track'>
				{
					[false, true].map((isDuplicate) => (
						<ul class='brands-grid' aria-hidden={isDuplicate ? 'true' : undefined}>
							{brandsData.items.map(({ name, logo: Logo }) => (
								<li class='brand-item surface-card'>
									<Logo class='brand-logo' aria-hidden='true' focusable='false' />
									<span>{name}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</Container>
</section>

<script>
	const brandsCarousel = document.querySelector<HTMLElement>('.brands-carousel');
	const brandsTrack = brandsCarousel?.querySelector<HTMLElement>('.brands-track');
	const brandsGrid = brandsCarousel?.querySelector<HTMLElement>('.brands-grid');
	if (brandsCarousel && brandsTrack && brandsGrid) {
		const updateBrandItemWidth = () => {
			const labels = Array.from(brandsGrid.querySelectorAll<HTMLElement>('.brand-item > span'));
			const items = Array.from(brandsGrid.querySelectorAll<HTMLElement>('.brand-item'));
			if (!labels.length || !items.length) return;

			const widestLabel = Math.max(...labels.map((label) => label.getBoundingClientRect().width));
			const itemStyle = getComputedStyle(items[0]);
			const inlineSpace = [
				'padding-left',
				'padding-right',
				'border-left-width',
				'border-right-width',
			].reduce(
				(total, property) => total + (Number.parseFloat(itemStyle.getPropertyValue(property)) || 0),
				0,
			);
			brandsCarousel.style.setProperty(
				'--brand-item-width',
				`${Math.ceil(widestLabel + inlineSpace)}px`,
			);
		};

		let previousTime = 0;
		let position = brandsCarousel.scrollLeft;
		let isDragging = false;
		let dragStartX = 0;
		let dragStartScroll = 0;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const speed = 24;

		const animate = (time: number) => {
			if (previousTime && !isDragging && !reducedMotion.matches) {
				position += (speed * (time - previousTime)) / 1000;
				const loopPoint = brandsGrid.scrollWidth;
				if (loopPoint && position >= loopPoint) {
					position -= loopPoint;
				}
				brandsCarousel.scrollLeft = position;
			}
			previousTime = time;
			window.requestAnimationFrame(animate);
		};

		brandsCarousel.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'mouse' && event.button !== 0) return;
			isDragging = true;
			dragStartX = event.clientX;
			dragStartScroll = brandsCarousel.scrollLeft;
			position = dragStartScroll;
			if (event.pointerType === 'mouse') brandsCarousel.setPointerCapture(event.pointerId);
		});
		brandsCarousel.addEventListener('pointermove', (event) => {
			if (!isDragging || event.pointerType !== 'mouse') return;
			position = dragStartScroll - (event.clientX - dragStartX);
			brandsCarousel.scrollLeft = position;
		});
		const endDrag = () => {
			if (!isDragging) return;
			isDragging = false;
			const loopPoint = brandsGrid.scrollWidth;
			if (loopPoint) {
				position = ((brandsCarousel.scrollLeft % loopPoint) + loopPoint) % loopPoint;
				brandsCarousel.scrollLeft = position;
			}
		};
		brandsCarousel.addEventListener('pointerup', endDrag);
		brandsCarousel.addEventListener('pointercancel', endDrag);
		brandsCarousel.addEventListener('lostpointercapture', endDrag);

		document.fonts.ready.then(updateBrandItemWidth);
		window.addEventListener('resize', updateBrandItemWidth, { passive: true });
		window.requestAnimationFrame(animate);
	}
</script>
