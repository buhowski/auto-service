---
import './Hours.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import content from '../../content/homepage.json';

const hoursContent = content.hours;
const hoursData = {
	sectionTitle: { eyebrow: hoursContent.eyebrow, headline: hoursContent.headline },
	lead: hoursContent.lead.replace('{address}', site.address.mapLabel),
	hours: site.openingHours,
	map: {
		address: site.address.mapLabel,
		embedUrl: site.address.mapEmbedUrl,
		directionsUrl: site.address.directionsUrl,
		directionsLabel: hoursContent.directionsLabel,
	},
	contact: [
		{
			icon: 'location',
			label: 'Адреса',
			links: [{ display: site.address.full, href: site.address.mapsUrl }],
		},
		{
			icon: 'phone',
			label: 'Контакти',
			links: [site.phone],
		},
	],
};
---

<section class='hours' id='visit' aria-labelledby='visit-heading'>
	<Container>
		<div class='hours__grid'>
			<div class='hours__info reveal'>
				<SectionHeader
					id='visit-heading'
					eyebrow={hoursData.sectionTitle.eyebrow}
					headline={hoursData.sectionTitle.headline}
				/>
				<p class='lead hours__lead'>{hoursData.lead}</p>

				<ul class='hours__table' data-hours-table role='list' aria-label='Графік роботи'>
					{
						hoursData.hours.map((hour) => (
							<li
								class:list={['hours__row', hour.isClosed && 'hours__row--closed']}
								data-hours-row
								data-day={hour.weekday}
							>
								<span class='hours__day'>{hour.day}</span>
								<span class='hours__time'>{hour.time}</span>
							</li>
						))
					}
				</ul>

				<div class='hours__contact'>
					{
						hoursData.contact.map((item) => (
							<div class='hours__line'>
								<Icon name={item.icon} width='20' height='20' />
								<div>
									<b>{item.label}</b>

									<div class='hours__links'>
										{item.links.map((link) => (
											<a
												class='hours__link'
												href={link.href}
												target={link.href.startsWith('http') ? '_blank' : undefined}
												rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
											>
												{link.display}
											</a>
										))}
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
			<div class='hours__map reveal'>
				<iframe
					class='hours__map-canvas'
					src={hoursData.map.embedUrl}
					loading='lazy'
					title={`Карта: ${hoursData.map.address}`}></iframe>
				<Button
					variant='primary'
					class='hours__map-route'
					href={hoursData.map.directionsUrl}
					target='_blank'
					rel='noopener noreferrer'
				>
					<Icon name='google-maps' width='20' height='20' />
					{hoursData.map.directionsLabel}
				</Button>
			</div>
		</div>
	</Container>
</section>

<script src='../../scripts/hours.ts'></script>
