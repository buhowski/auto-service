---
import './Hours.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
const hoursData = {
	sectionTitle: { eyebrow: 'Знайдіть нас · Графік роботи', headline: 'Заїздіть до боксу' },
	lead: `Ми на ${site.address.mapLabel}, поруч зі зручною парковкою та комфортною зоною очікування з кавою. Є ключова скринька для ранньої та пізньої передачі авто.`,
	hours: site.openingHours,
	contact: [
		{
			icon: 'location',
			label: 'Адреса',
			value: site.address.full,
			href: site.address.mapsUrl,
		},
		{ icon: 'phone', label: 'Телефон', value: site.phone.display, href: site.phone.href },
	],
	map: {
		address: site.address.mapLabel,
		directionsUrl: site.address.mapsUrl,
	},
};
---

<section class='hours-section' id='visit' aria-labelledby='visit-heading'>
	<Container>
		<div class='visit-grid'>
			<div class='visit-info reveal'>
				<SectionHeader
					id='visit-heading'
					eyebrow={hoursData.sectionTitle.eyebrow}
					headline={hoursData.sectionTitle.headline}
				/>
				<p class='lead'>{hoursData.lead}</p>

				<ul class='hours-table' role='list' aria-label='Графік роботи'>
					{
						hoursData.hours.map((hour, index) => (
							<li class={hour.isClosed ? 'closed' : ''} data-day={index === 6 ? 0 : index + 1}>
								<span class='day'>{hour.day}</span>
								<span class='hrs'>{hour.time}</span>
							</li>
						))
					}
				</ul>

				<div class='visit-contact'>
					{
						hoursData.contact.map((item) => (
							<div class='visit-line'>
								<Icon name={item.icon} width='20' height='20' />
								<div>
									<b>{item.label}</b>
									<a href={item.href}>{item.value}</a>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class='visit-map reveal'>
				<div class='map-diag' aria-hidden='true'></div>
				<div class='map-pin'>
					<Icon name='location' class='map-pin-dot' width='40' height='40' aria-hidden={true} />

					<div class='map-addr'>{hoursData.map.address}</div>
					<Button variant='dark' href={hoursData.map.directionsUrl} target='_blank' rel='noopener'>
						Отримати маршрут
					</Button>
				</div>
			</div>
		</div>
	</Container>
</section>

<script>
	const localDay = new Intl.DateTimeFormat('en-US', {
		weekday: 'short',
		timeZone: 'Europe/Kyiv',
	}).format(new Date());
	const dayIndexes = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
	const todayIndex = dayIndexes.indexOf(localDay);
	document.querySelector(`.hours-table [data-day="${todayIndex}"]`)?.classList.add('today');
</script>
