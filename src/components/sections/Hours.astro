---
import './Hours.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import content from '../../content/homepage.json';
const hoursContent = content.hours;
const hoursData = {
	sectionTitle: { eyebrow: hoursContent.eyebrow, headline: hoursContent.headline },
	lead: hoursContent.lead.replace('{address}', site.address.mapLabel),
	hours: site.openingHours,
	contact: [
		{
			icon: 'location',
			label: 'Адреса',
			links: [{ display: site.address.full, href: site.address.mapsUrl }],
		},
		{
			icon: 'phone',
			label: 'Контакти',
			links: [site.phone],
		},
	],
	map: {
		address: site.address.mapLabel,
		directionsUrl: site.address.mapsUrl,
		directionsLabel: hoursContent.directionsLabel,
	},
};
---

<section class='hours-section' id='visit' aria-labelledby='visit-heading'>
	<Container>
		<div class='visit-grid'>
			<div class='visit-info reveal'>
				<SectionHeader
					id='visit-heading'
					eyebrow={hoursData.sectionTitle.eyebrow}
					headline={hoursData.sectionTitle.headline}
				/>
				<p class='lead'>{hoursData.lead}</p>

				<ul class='hours-table' role='list' aria-label='Графік роботи'>
					{
						hoursData.hours.map((hour) => (
							<li class={hour.isClosed ? 'closed' : ''} data-day={hour.weekday}>
								<span class='day'>{hour.day}</span>
								<span class='hrs'>{hour.time}</span>
							</li>
						))
					}
				</ul>

				<div class='visit-contact'>
					{
						hoursData.contact.map((item) => (
							<div class='visit-line'>
								<Icon name={item.icon} width='20' height='20' />
								<div>
									<b>{item.label}</b>

									<div class='visit-line__block'>
										{item.links.map((link) => (
											<a class='visit-line__link' href={link.href}>
												{link.display}
											</a>
										))}
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class='visit-map reveal'>
				<div class='map-diag' aria-hidden='true'></div>
				<div class='map-pin'>
					<Icon name='location' class='map-pin-dot' width='40' height='40' aria-hidden={true} />

					<div class='map-addr'>{hoursData.map.address}</div>
					<Button variant='dark' href={hoursData.map.directionsUrl} target='_blank' rel='noopener'>
						{hoursData.map.directionsLabel}
					</Button>
				</div>
			</div>
		</div>
	</Container>
</section>

<script src='../../scripts/hours.ts'></script>
