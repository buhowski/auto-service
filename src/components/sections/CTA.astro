---
import './CTA.scss';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { site } from '../../data/site';
const ctaData = {
	eyebrow: 'Готові коли ви',
	headline: 'Запишіться на сервіс сьогодні',
	subtext:
		'Запис у той самий день, прозорі ціни та гарантія, на яку можна розраховувати. Подбаймо, щоб ваше авто працювало якнайкраще.',
	primaryCta: { text: 'Записатися', href: site.links.booking },
	secondaryCta: { text: 'Зателефонувати', href: site.phone.href },
};
---

<section class='cta-band' aria-labelledby='cta-heading'>
	<div class='cta-bg' aria-hidden='true'></div>
	<Container size='lg'>
		<div class='cta-content'>
			<SectionHeader
				id='cta-heading'
				eyebrow={ctaData.eyebrow}
				headline={ctaData.headline}
				description={ctaData.subtext}
				centered
			/>
			<div class='cta-actions'>
				<Button variant='accent' size='lg' href={ctaData.primaryCta.href}>
					{ctaData.primaryCta.text}
				</Button>
				<Button variant='ghost' size='lg' href={ctaData.secondaryCta.href}>
					{ctaData.secondaryCta.text}
				</Button>
			</div>
		</div>
	</Container>
</section>
