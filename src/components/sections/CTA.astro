---
import './CTA.scss';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import BackgroundMedia from '../ui/BackgroundMedia.astro';
import { site } from '../../data/site';
import content from '../../content/homepage.json';
const ctaData = content.cta;
---

<section class='cta-band' aria-labelledby='cta-heading'>
	<div class='cta-bg bg-overlay' aria-hidden='true'>
		<BackgroundMedia media={ctaData.background} />
	</div>
	<div class='cta-chequer' aria-hidden='true'></div>
	<div class='cta-chequer cta-chequer--bottom' aria-hidden='true'></div>
	<Container>
		<div class='cta-content'>
			<SectionHeader
				id='cta-heading'
				eyebrow={ctaData.eyebrow}
				headline={ctaData.headline}
				description={ctaData.subtext}
				centered
			/>
			<div class='cta-actions'>
				<Button variant='primary' href={site.links.booking} data-booking-open
					>{ctaData.primaryCta}</Button
				>
				<Button variant='secondary' href={site.phone.href}>{ctaData.secondaryCta}</Button>
			</div>
		</div>
	</Container>
</section>
