---
import './Hero.scss';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { openingHoursSummary, site } from '../../data/site';
const heroData = {
	badge: site.city,
	openingHours: openingHoursSummary,
	headline: 'Чесні ремонти Прямі відповіді',
	highlightedWord: 'Прямі',
	subtext:
		'Від швидкої заміни олії до капітального ремонту двигуна — СТО Поршень тримає ваш авто в безпеці на дорозі з прозорими цінами, сертифікованими майстрами та гарантією 24 місяці на кожен ремонт.',
	primaryCta: { text: 'Записатися', href: site.links.booking },
	secondaryCta: { text: 'Послуги', href: site.links.services },
	backgroundImage: '/hero-garage.jpg',
	backgroundAlt:
		'Механік у спецовдязі працює під авто, піднятим на гідравлічному підйомі, у сучасному сервісному боксі',
};
const [headlineStart, headlineEnd = ''] = heroData.headline.split(heroData.highlightedWord);
---

<section class='hero' id='hero' aria-labelledby='hero-heading'>
	<div class='hero-bg'>
		<img
			src={heroData.backgroundImage}
			alt={heroData.backgroundAlt}
			width='1600'
			height='1100'
			fetchpriority='high'
		/>
	</div>

	<Container>
		<div class='hero-grid'>
			<div class='hero-content'>
				<div class='hero-meta' aria-label='Місто та графік роботи'>
					<span class='hero-location'>{heroData.badge}</span>
					<span class='hero-meta-divider' aria-hidden='true'></span>
					<span class='hero-hours'>{heroData.openingHours}</span>
				</div>
				<h1 id='hero-heading' class='hero-title'>
					<span class='hero-title-line'>{headlineStart}</span>
					<span class='u'>{heroData.highlightedWord}</span>{headlineEnd}
				</h1>
				<p class='hero-sub'>{heroData.subtext}</p>

				<div class='hero-actions'>
					<Button variant='primary' href={heroData.primaryCta.href}>
						{heroData.primaryCta.text}
					</Button>

					<Button variant='secondary' href={heroData.secondaryCta.href}>
						{heroData.secondaryCta.text}
					</Button>
				</div>
			</div>
		</div>
	</Container>
</section>
