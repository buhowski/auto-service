---
import './Testimonials.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import content from '../../content/homepage.json';
const testimonialsData = content.testimonials;
---

<section class='testimonials' id='testimonials' aria-labelledby='testimonials-heading'>
	<Container>
		<SectionHeader
			id='testimonials-heading'
			eyebrow={testimonialsData.eyebrow}
			headline={testimonialsData.headline}
			centered
		/>

		<div class='testimonials__carousel' data-testi>
			<div class='testimonials__viewport'>
				<div class='testimonials__track' data-testi-track aria-live='polite'>
					{
						testimonialsData.items.map((testi, index) => (
							<div class='testimonials__slide' data-testi-slide aria-label={`Відгук ${index + 1}`} tabindex='-1'>
								<article class='testimonials__card'>
									<div class='testimonials__stars' aria-label={`Оцінка ${testi.rating} з 5`} role='img'>
										{Array.from({ length: 5 }).map((_, i) => (
											<Icon
												name={i < testi.rating ? 'star' : 'starOutline'}
												width='18'
												height='18'
											/>
										))}
									</div>
									<p class='testimonials__quote' tabindex='0'>"{testi.quote}"</p>
									<div class='testimonials__author'>
										<img
											src={testi.author.image}
											alt={testi.author.imageAlt}
											width='52'
											height='52'
											loading='lazy'
										/>
										<div>
											<b>{testi.author.name}</b>
											<span>{testi.author.role}</span>
										</div>
									</div>
								</article>
							</div>
						))
					}
				</div>
			</div>
			<div class='testimonials__navigation' aria-label='Навігація відгуків'>
				<button class='testimonials__button' data-testi-prev aria-label='Попередній відгук'>
					<Icon name='chevronLeft' width='20' height='20' />
				</button>
				<button class='testimonials__button' data-testi-next aria-label='Наступний відгук'>
					<Icon name='chevronRight' width='20' height='20' />
				</button>
			</div>
		</div>
	</Container>
</section>

<script src="../../scripts/testimonials.ts"></script>
