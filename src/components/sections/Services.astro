---

<section class='services-section' id='services' aria-labelledby='services-heading'>
	<Container>
		<SectionHeader
			id='services-heading'
			eyebrow='Прайс на послуги'
			headline='Прозорі ціни на ремонт і обслуговування'
		/>

		<div class='services-catalog'>
			<div class='services-category-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<button
							class:list={['service-category', { 'is-active': index === 0 }]}
							id={`desktop-service-trigger-${category.id}`}
							data-service-trigger
							aria-expanded={index === 0 ? 'true' : 'false'}
							aria-controls={`desktop-service-panel-${category.id}`}
							type='button'
						>
							<span class='service-category-copy'>
								<span class='service-category-title'>{category.title}</span>
								<span class='service-category-count'>{category.services.length} послуг</span>
							</span>
							<span class='service-category-arrow' aria-hidden='true'>
								<Icon name='circleArrowDown' width='20' height='20' />
							</span>
						</button>
					))
				}
			</div>

			<div class='services-panel-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<ServicePricePanel
							id={`desktop-service-panel-${category.id}`}
							triggerId={`desktop-service-trigger-${category.id}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					))
				}
			</div>
		</div>

		<div class='services-mobile-list' data-service-set='mobile'>
			{
				categories.map((category, index) => (
					<div class='service-entry'>
						<button
							class:list={['service-category', { 'is-active': index === 0 }]}
							id={`mobile-service-trigger-${category.id}`}
							data-service-trigger
							aria-expanded={index === 0 ? 'true' : 'false'}
							aria-controls={`mobile-service-panel-${category.id}`}
							type='button'
						>
							<span class='service-category-copy'>
								<span class='service-category-title'>{category.title}</span>
								<span class='service-category-count'>{category.services.length} послуг</span>
							</span>
							<span class='service-category-arrow' aria-hidden='true'>
								<Icon name='circleArrowDown' width='20' height='20' />
							</span>
						</button>
						<ServicePricePanel
							id={`mobile-service-panel-${category.id}`}
							triggerId={`mobile-service-trigger-${category.id}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					</div>
				))
			}
		</div>
	</Container>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-service-set]').forEach((serviceSet) => {
		const triggers = Array.from(
			serviceSet.querySelectorAll<HTMLButtonElement>('[data-service-trigger]'),
		);
		const panels = triggers.map((trigger) =>
			document.getElementById(trigger.getAttribute('aria-controls') ?? ''),
		);
		const allowCollapse = serviceSet.dataset.serviceSet === 'mobile';
		triggers.forEach((trigger, activeIndex) => {
			trigger.addEventListener('click', () => {
				const shouldClose = allowCollapse && trigger.getAttribute('aria-expanded') === 'true';
				triggers.forEach((item, index) => {
					const expanded = !shouldClose && index === activeIndex;
					item.setAttribute('aria-expanded', String(expanded));
					item.classList.toggle('is-active', expanded);
					if (panels[index]) panels[index]!.hidden = !expanded;
				});
			});
		});
	});
</script>
