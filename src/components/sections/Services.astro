---
import './Services.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ServicePricePanel from './ServicePricePanel.astro';
import ServiceCategoryTrigger from './ServiceCategoryTrigger.astro';
import servicesData from '../../content/services.json';
const { categories } = servicesData;
---

<section class='services-section' id='services' aria-labelledby='services-heading'>
	<Container>
		<SectionHeader
			id='services-heading'
			eyebrow={servicesData.eyebrow}
			headline={servicesData.headline}
		/>

		<div class='services-catalog'>
			<div class='services-category-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<ServiceCategoryTrigger
							category={category}
							triggerId={`desktop-service-trigger-${category.id}`}
							panelId={`desktop-service-panel-${category.id}`}
							active={index === 0}
						/>
					))
				}
			</div>

			<div class='services-panel-list' data-service-set='desktop'>
				{
					categories.map((category, index) => (
						<ServicePricePanel
							id={`desktop-service-panel-${category.id}`}
							triggerId={`desktop-service-trigger-${category.id}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					))
				}
			</div>
		</div>

		<div class='services-mobile-list' data-service-set='mobile'>
			{
				categories.map((category, index) => (
					<div class='service-entry'>
						<ServiceCategoryTrigger
							category={category}
							triggerId={`mobile-service-trigger-${category.id}`}
							panelId={`mobile-service-panel-${category.id}`}
							active={index === 0}
						/>
						<ServicePricePanel
							id={`mobile-service-panel-${category.id}`}
							triggerId={`mobile-service-trigger-${category.id}`}
							title={category.title}
							services={category.services}
							active={index === 0}
						/>
					</div>
				))
			}
		</div>
	</Container>
</section>

<script src="../../scripts/services.ts"></script>
