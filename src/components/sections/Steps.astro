---
import './Steps.scss';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import content from '../../content/homepage.json';
const stepsData = content.steps;
---

<section class="steps" id="steps" aria-labelledby="steps-heading">
	<Container size="lg">
		<SectionHeader
			id="steps-heading"
			eyebrow={stepsData.eyebrow}
			headline={stepsData.headline}
			centered
		/>

		<div class="steps__grid">
			{stepsData.items.map((step, index) => (
				<article class="steps__item reveal" data-delay={index * 100}>
					<div class="steps__meta">
						<span class="steps__number">{String(index + 1).padStart(2, '0')}</span>
						<span class="steps__icon"><Icon name={step.icon as 'step1' | 'step2' | 'step3'} width="24" height="24" /></span>
					</div>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</article>
			))}
		</div>
	</Container>
</section>
