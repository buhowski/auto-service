---
import './WhyChoose.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

const whyChooseData = (await getCollection('whyChoose', ({ id }) => id === 'main'))[0]?.data;
---

<section class="why-choose" id="why-choose" aria-labelledby="why-choose-heading">
  <Container size="lg">
    <div class="why-grid">
      <div class="why-media reveal">
        <img 
          src={whyChooseData.image.src} 
          alt={whyChooseData.image.alt}
          width="1000" 
          height="1200" 
          loading="lazy"
        >
      </div>
      <div class="why-content">
        <SectionHeader 
			id="why-choose-heading"
          eyebrow={whyChooseData.sectionTitle.eyebrow}
          headline={whyChooseData.sectionTitle.headline}
        />
        <p class="lead">{whyChooseData.lead}</p>
        
        <ul class="why-list" role="list">
          {whyChooseData.items.map((item, index) => (
            <li class="why-item reveal" style={`--delay: ${index * 100}ms`}>
              <span class="why-icon">
                <Icon name={item.icon} width="24" height="24" />
              </span>
              <div>
                <h4>{item.title}</h4>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>

