---
import './WhyChoose.scss';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import content from '../../content/homepage.json';
const whyChooseData = content.whyChoose;
---

<section class="why-choose" id="why-choose" aria-labelledby="why-choose-heading">
  <Container>
    <div class="why-choose__grid">
      <div class="why-choose__media reveal">
        <img 
					  src={whyChooseData.image}
					  alt={whyChooseData.imageAlt}
          width="1000" 
          height="1200" 
          loading="lazy"
        >
      </div>
      <div>
				<SectionHeader
					id="why-choose-heading"
					eyebrow={whyChooseData.eyebrow}
					headline={whyChooseData.headline}
        />
        <p class="lead why-choose__lead">{whyChooseData.lead}</p>
        
        <ul class="why-choose__list" role="list">
          {whyChooseData.items.map((item, index) => (
            <li class="why-choose__item reveal" data-delay={index * 100}>
              <span class="why-choose__icon">
									<Icon name={item.icon as 'certified' | 'quote' | 'warranty' | 'speed'} width="24" height="24" />
              </span>
              <div>
                <h4>{item.title}</h4>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>

