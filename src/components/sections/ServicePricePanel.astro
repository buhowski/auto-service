---
import './ServicePricePanel.scss';
import Button from '../ui/Button.astro';
import servicesData from '../../content/services.json';

type Service = (typeof servicesData.categories)[number]['services'][number];

interface Props {
	id: string;
	triggerId: string;
	title: string;
	services: Service[];
	active?: boolean;
}

const { id, triggerId, title, services, active = false } = Astro.props;
---

<div
	class='service-price-panel'
	id={id}
	role='region'
	aria-labelledby={triggerId}
	hidden={!active}
>
	<div class='service-price-panel__heading'>
		<div>
			<span class='service-price-panel__kicker'>Послуги та ціни</span>
			<h3>{title}</h3>
		</div>
	</div>
	<div class='service-price-panel__list'>
		{
			services.map((service) => (
				<div class='service-price-panel__row'>
					<span class='service-price-panel__name'>{service.name}</span>
					<span class='service-price-panel__price'>{service.price}</span>
					<Button
						variant='primary'
						class='service-price-panel__order'
						aria-label={`Замовити послугу: ${service.name}`}
						data-booking-open
					>
						Замовити
					</Button>
				</div>
			))
		}
	</div>
	<p class='service-price-panel__note'>
		Точна вартість залежить від марки авто та складності робіт. Підтвердимо ціну перед ремонтом.
	</p>
</div>
