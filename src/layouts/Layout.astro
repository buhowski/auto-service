---
import '../styles/index.scss';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import BookingModal from '../components/ui/BookingModal.astro';
import { site } from '../data/site';
---

<!doctype html>
<html lang='uk'>
	<head>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta
			name='description'
			content={`${site.name} — чесний автосервіс у ${site.city}. Сертифіковані майстри, прозорі ціни, гарантія 24 місяці. Запис онлайн або за телефоном ${site.phone.display}.`}
		/>
		<meta name='theme-color' content='var(--color-ink)' />
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Fira+Sans+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap'
			rel='stylesheet'
		/>
		<title>{site.name} — {site.city}</title></head
	>: чесний авторемонт, ТО, діагностика

	<body>
		<Header />
		<main id='main'>
			<slot />
		</main>
		<Footer />
		<BookingModal />

		<script src='../scripts/reveal.ts'></script>
	</body>


</html>
